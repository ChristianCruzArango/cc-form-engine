{
  "name": "cc-form-engine",
  "version": "1.1.0",
  "description": "Advanced Angular library for reactive form generation and management with dynamic validation, change tracking, and customizable error messages",
  "keywords": [
    "angular",
    "form",
    "library",
    "reactive-forms",
    "validation",
    "form-generator",
    "typescript",
    "signals",
    "form-engine"
  ],
  "homepage": "https://github.com/ChristianCruzArango/cc-form-engine#readme",
  "bugs": {
    "url": "https://github.com/ChristianCruzArango/cc-form-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianCruzArango/cc-form-engine.git"
  },
  "license": "MIT",
  "author": "Christian Alexis Cruz Arango",
  "main": "bundles/cc-form-engine.umd.js",
  "module": "fesm2022/cc-form-engine.mjs",
  "es2020": "fesm2020/cc-form-engine.mjs", 
  "esm2020": "esm2020/cc-form-engine.mjs",
  "fesm2020": "fesm2020/cc-form-engine.mjs",
  "fesm2022": "fesm2022/cc-form-engine.mjs",
  "typings": "index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "esm2020": "./esm2020/cc-form-engine.mjs",
      "es2020": "./fesm2020/cc-form-engine.mjs",
      "es2015": "./fesm2015/cc-form-engine.mjs",
      "node": "./fesm2015/cc-form-engine.mjs",
      "default": "./fesm2022/cc-form-engine.mjs"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/common": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "rxjs": "^7.8.0"
  },
  "sideEffects": false
}
